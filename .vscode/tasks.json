{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Flash Device",
            "type": "process",
            "command": "STM32_Programmer_CLI",
            "args": [
                "-c",
                "port=SWD",
                "mode=UR",
                "-w",
                "${workspaceFolder}\\build\\debug_GCC_NUCLEO-C542RC\\v_box.elf", 
                "-v",
                "-rst"
            ],
            "group": "build",
            "presentation": {
                "echo": true,
                "reveal": "always",
                "focus": false,
                "panel": "shared",
                "clear": true
            },
            "problemMatcher": []
        },
        {
            "label": "[Flash] Full Merged Image (Bootloader + App)",
            "type": "process",
            "command": "STM32_Programmer_CLI",
            "args": [
                "-c",
                "port=SWD",
                "mode=UR",
                "-w",
                "${workspaceFolder}\\build\\debug_GCC_NUCLEO-C542RC\\v_box_full.hex",
                "-v",
                "-rst"
            ],
            "group": "build",
            "presentation": {
                "echo": true,
                "reveal": "always",
                "focus": false,
                "panel": "shared",
                "clear": true
            },
            "problemMatcher": []
        },
        {
            "label": "[Flash] Bootloader Only",
            "type": "process",
            "command": "STM32_Programmer_CLI",
            "args": [
                "-c",
                "port=SWD",
                "mode=UR",
                "-w",
                "${workspaceFolder}\\build\\debug_GCC_NUCLEO-C542RC\\v_box_boot.hex",
                "-v",
                "-rst"
            ],
            "group": "build",
            "presentation": {
                "echo": true,
                "reveal": "always",
                "focus": false,
                "panel": "shared",
                "clear": true
            },
            "problemMatcher": []
        },
        {
            "label": "[Flash] MainApp Only",
            "type": "process",
            "command": "STM32_Programmer_CLI",
            "args": [
                "-c",
                "port=SWD",
                "mode=UR",
                "-w",
                "${workspaceFolder}\\build\\debug_GCC_NUCLEO-C542RC\\v_box.hex",
                "-v",
                "-rst"
            ],
            "group": "build",
            "presentation": {
                "echo": true,
                "reveal": "always",
                "focus": false,
                "panel": "shared",
                "clear": true
            },
            "problemMatcher": []
        },
        {
            "label": "[Windows] Configure",
            "type": "cmake",
            "command": "configure",
            "problemMatcher": []
        },
        {
            "label": "[Windows] Build",
            "dependsOn": [
                "[Windows] Configure"
            ],
            "dependsOrder": "sequence",
            "type": "cmake",
            "command": "build",
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "problemMatcher": [
                "$gcc"
            ]
        },
        {
            "label": "[Windows] Clean",
            "type": "cmake",
            "command": "clean",
            "problemMatcher": []
        },
        {
            "label": "[Windows] Rebuild",
            "dependsOn": [
                "[Windows] Clean",
                "[Windows] Build"
            ],
            "dependsOrder": "sequence",
            "group": "build",
            "problemMatcher": []
        },
        {
            "label": "[Windows] Build & Flash",
            "dependsOn": [
                "[Windows] Build",
                "Flash Device"
            ],
            "dependsOrder": "sequence",
            "group": "build",
            "problemMatcher": []
        },
        {
            "label": "[Docker] Build",
            "type": "process",
            "command": "cmd.exe",
            "args": [
                "/c",
                "${workspaceFolder}\\.devcontainer\\docker_build.bat"
            ],
            "group": "build",
            "presentation": {
                "echo": true,
                "reveal": "always",
                "focus": false,
                "panel": "shared",
                "clear": true
            },
            "problemMatcher": [
                "$gcc"
            ]
        },
        {
            "label": "[Docker] Rebuild",
            "type": "process",
            "command": "cmd.exe",
            "args": [
                "/c",
                "${workspaceFolder}\\.devcontainer\\docker_build.bat",
                "rebuild"
            ],
            "group": "build",
            "presentation": {
                "echo": true,
                "reveal": "always",
                "focus": false,
                "panel": "shared",
                "clear": true
            },
            "problemMatcher": [
                "$gcc"
            ]
        },
        {
            "label": "[Docker] Build & Flash",
            "dependsOn": [
                "[Docker] Build",
                "Flash Device"
            ],
            "dependsOrder": "sequence",
            "group": "build",
            "problemMatcher": []
        },
        {
            "label": "Clean All",
            "type": "process",
            "command": "cmd.exe",
            "args": [
                "/c",
                "if exist build rmdir /s /q build"
            ],
            "presentation": {
                "echo": true,
                "reveal": "always",
                "focus": false,
                "panel": "shared",
                "clear": true
            },
            "problemMatcher": []
        },
        {
            "label": "[USB] Attach ST-Link to Docker",
            "type": "process",
            "command": "cmd.exe",
            "args": [
                "/c",
                "${workspaceFolder}\\.devcontainer\\stlink_attach.bat"
            ],
            "presentation": {
                "echo": true,
                "reveal": "always",
                "focus": false,
                "panel": "shared",
                "clear": true
            },
            "problemMatcher": []
        },
        {
            "label": "[USB] Detach ST-Link from Docker",
            "type": "process",
            "command": "cmd.exe",
            "args": [
                "/c",
                "${workspaceFolder}\\.devcontainer\\stlink_detach.bat"
            ],
            "presentation": {
                "echo": true,
                "reveal": "always",
                "focus": false,
                "panel": "shared",
                "clear": true
            },
            "problemMatcher": []
        },
        {
            "label": "[Docker] Export Image to Archive",
            "type": "process",
            "command": "cmd.exe",
            "args": [
                "/c",
                "${workspaceFolder}\\.devcontainer\\export_image.bat"
            ],
            "presentation": {
                "echo": true,
                "reveal": "always",
                "focus": false,
                "panel": "shared",
                "clear": true
            },
            "problemMatcher": []
        },
        {
            "label": "[Docker] Import Image from Archive",
            "type": "process",
            "command": "cmd.exe",
            "args": [
                "/c",
                "${workspaceFolder}\\.devcontainer\\import_image.bat"
            ],
            "presentation": {
                "echo": true,
                "reveal": "always",
                "focus": false,
                "panel": "shared",
                "clear": true
            },
            "problemMatcher": []
        }
    ]
}
