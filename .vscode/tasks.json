{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "STM32: Flash Device",
            "type": "process",
            "command": "STM32_Programmer_CLI",
            "args": [
                "-c",
                "port=SWD",
                "mode=UR",
                "-w",
                "${workspaceFolder}\\build\\debug_GCC_NUCLEO-C542RC\\v_box.elf", 
                "-v",
                "-rst"
            ],
            "group": "build",
            "presentation": {
                "echo": true,
                "reveal": "always",
                "focus": false,
                "panel": "shared",
                "clear": true
            },
            "problemMatcher": []
        },
        {
            "label": "Build",
            "type": "cmake",
            "command": "build",
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "problemMatcher": [
                "$gcc"
            ]
        },
        {
            "label": "Build & Flash",
            "dependsOn": [
                "Build",
                "STM32: Flash Device"
            ],
            "dependsOrder": "sequence",
            "problemMatcher": [],
            "group": "build"
        },
        {
            "label": "Clean",
            "type": "cmake",
            "command": "clean",
            "problemMatcher": []
        },
        {
            "label": "Rebuild",
            "dependsOn": [
                "Clean",
                "Build"
            ],
            "dependsOrder": "sequence",
            "problemMatcher": [],
            "group": "build"
        },
        {
            "label": "Rebuild & Flash",
            "dependsOn": [
                "Rebuild",
                "STM32: Flash Device"
            ],
            "dependsOrder": "sequence",
            "problemMatcher": [],
            "group": "build"
        }
    ]
}

