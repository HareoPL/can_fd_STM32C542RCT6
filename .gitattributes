# Auto-detect text files and normalize line endings
* text=auto

# Source code and configuration files (force LF)
*.c text eol=lf
*.h text eol=lf
*.py text eol=lf
*.json text eol=lf
*.md text eol=lf
*.cmake text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.sh text eol=lf
CMakeLists.txt text eol=lf
Dockerfile text eol=lf
.clangd text eol=lf
.gitignore text eol=lf
.gitattributes text eol=lf

# Windows batch files (must have CRLF for cmd.exe)
*.bat text eol=crlf
*.cmd text eol=crlf

# Binary files
*.bin filter=lfs diff=lfs merge=lfs -text
*.tar binary
*.tar.gz binary
*.elf binary
*.hex binary
*.o binary
*.a binary
*.png binary
*.jpg binary
*.ico binary
